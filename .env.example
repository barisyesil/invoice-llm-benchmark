# ============================================================
# llm-fis-lab — API anahtarlari
# Bu dosyayi ".env.local" olarak kopyalayin ve doldurun.
# Sadece doldurdugunuz saglayicilarin modelleri arayuzde aktif olur;
# anahtari olmayanlar "anahtar yok" rozetiyle pasif gorunur.
# ============================================================

# --- OpenAI ---------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic (Claude) --------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Gemini -------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Groq ----------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- OpenRouter (tek anahtarla onlarca model) ----------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Ollama / yerel (anahtar gerekmez, degeri onemsiz) -------
# Yerel modelleri denemek isterseniz config/models.json icindeki
# "ollama" saglayicisini ve modelini aktif edin.
OLLAMA_API_KEY=yerel
